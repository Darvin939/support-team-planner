# По умолчанию используется SQLite; PostgreSQL URL должен отсутствовать.
SUPPORT_PLANNER_DB_PATH=database.db

# Для PostgreSQL раскомментируйте URL своего экземпляра.
# Пароль передайте отдельно через защищённое окружение PGPASSWORD.
# SUPPORT_PLANNER_DATABASE_URL=postgresql://planner_runtime@db.example.internal:5432/planner?sslmode=verify-full
# Имя схемы, по умолчанию planner; её заранее создаёт администратор БД.
# Одно значение для приложения, мигратора и импорта SQLite.
# SUPPORT_PLANNER_DATABASE_SCHEMA=planner
# PGSSLROOTCERT=/etc/planner/postgresql-root.crt
# SESSION_SECRET_KEY=задайте-собственный-случайный-секрет-через-окружение

# Только отдельная тестовая БД: тесты могут полностью очистить её данные.
# В ней также заранее создайте схему из SUPPORT_PLANNER_DATABASE_SCHEMA.
# SUPPORT_PLANNER_TEST_BACKEND=postgresql
# SUPPORT_PLANNER_TEST_DATABASE_URL=postgresql://planner_runtime@db.example.internal:5432/planner_test?sslmode=verify-full
# SUPPORT_PLANNER_TEST_MIGRATION_URL=postgresql://planner_migration@db.example.internal:5432/planner_test?sslmode=verify-full
