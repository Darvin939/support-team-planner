# Контекст — распакованный дистрибутив с добавленным пользователем pip.conf.
**
!Dockerfile
!.dockerignore
!pip.conf
!requirements.txt
!support_planner.py
!application_version.json
!changelog.json
!app_build_metadata.json

!backend/
backend/*
!backend/*.py
!backend/db/
backend/db/*
!backend/db/*.py
!backend/db/*.sql
!backend/routers/
backend/routers/*
!backend/routers/*.py

!frontend/
frontend/*
!frontend/dist/
!frontend/dist/**

!scripts/
scripts/*
!scripts/__init__.py
!scripts/migrate_database.py
!scripts/import_sqlite_to_postgres.py

# Исключения действуют и внутри разрешённых runtime-каталогов.
**/.env
**/.env.*
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
**/*.bak
**/*.dump
**/*.log
**/*.log.*
**/__pycache__
**/*.py[cod]
**/node_modules
**/.venv
**/venv
**/.git
**/openspec
**/tests
**/test_*.py
**/*_test.py
**/.tmp
**/.DS_Store
**/._*
